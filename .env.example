# ─── Web ──────────────────────────────────────────────────────────────────
# Internal HTTP port (docker-compose binds it to 127.0.0.1 only — public access
# goes through the Caddy sidecar over HTTPS).
APP_PORT=8765
PUBLIC_BASE_URL=https://gx10-d4bc:8767
# Set to a long random string before exposing to anything beyond localhost.
ADMIN_TOKEN=change-me-please

# ─── TLS (handled by the bundled Caddy sidecar — see docker/Caddyfile) ────
# Hostname used in the cert SAN and in browser URLs.
LOCAL_HOST=gx10-d4bc
# Public HTTPS port. URL: https://${LOCAL_HOST}:${HTTPS_PORT}
HTTPS_PORT=8767

# ─── Scraping ─────────────────────────────────────────────────────────────
# Minutes between reservation polls
SCRAPE_INTERVAL_MINUTES=5
# How many months ahead of "today" to look
LOOKAHEAD_MONTHS=6
# Set true to skip drilling into each yellow day for time slots (faster but less detail)
SKIP_DAY_DETAIL=false
# Headless browser timeout (ms) per page load
PLAYWRIGHT_TIMEOUT_MS=20000

# ─── Notifications ────────────────────────────────────────────────────────
# Gmail SMTP — generate an App Password at https://myaccount.google.com/apppasswords
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_USERNAME=your-account@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
GMAIL_FROM_NAME=Lycée Hôtelier Watcher

# Hour (24h, server local time / TZ below) for the daily menu refresh scrape
DAILY_MENU_SCRAPE_HOUR=8

# ─── IMAP unsubscribe ─────────────────────────────────────────────────────
# Poll the same Gmail inbox for incoming "STOP <token>" / "START <token>"
# emails so subscribers can manage themselves without exposing the server.
IMAP_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL_MINUTES=2

# ─── Misc ─────────────────────────────────────────────────────────────────
# Optional: override where SQLite/menu files are stored.
# Local runs default to ./data; docker-compose sets this to /data.
# DATA_DIR=/absolute/path
TZ=Europe/Paris
LOG_LEVEL=INFO
# Set true to disable actually sending emails / chat (useful for first runs)
NOTIFICATIONS_DRY_RUN=false

# ─── Bootstrap ────────────────────────────────────────────────────────────
# If BOOTSTRAP_USER_EMAIL is set AND the users table is empty on first boot,
# a starter subscriber is created. notify_email/notify_gchat default to FALSE
# (toggle them in /users after a test).
BOOTSTRAP_USER_NAME=Admin
BOOTSTRAP_USER_EMAIL=
BOOTSTRAP_USER_GCHAT_WEBHOOK=
# One of: lunch | dinner | both
BOOTSTRAP_USER_PREFERENCE=both

# ─── Target URLs ──────────────────────────────────────────────────────────
# Override only if the school changes its web addresses.
MENUS_INDEX_URL=https://www.hoteloccitanietoulouse.com/agenda/do/tag/menus/
RESERVATION_URL=https://www.covermanager.com/reserve/module_restaurant/restaurant-restaurant-d-application-d-occitanie/french
SITE_ROOT=https://www.hoteloccitanietoulouse.com
